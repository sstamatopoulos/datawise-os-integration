# Reverse proxy and access control for the whole stack.
#
# PUBLIC_HOST=localhost -> Caddy issues its own certificates (trust its root
# CA once: `docker compose exec caddy cat /data/caddy/pki/authorities/local/root.crt`).
# PUBLIC_HOST=your.domain -> certificates from Let's Encrypt, ACME_EMAIL set.
#
# Three hostnames:
#   {PUBLIC_HOST}          Airflow (its own login)
#   orion.{PUBLIC_HOST}    NGSI-LD broker, X-API-Key required
#   influx.{PUBLIC_HOST}   InfluxDB (its own token / login)
#
# Replacing this with nginx or another proxy is a contained change (see the
# reasoning in ROADMAP.md section 3). Whatever does the job has to keep four
# promises, because the rest of the platform assumes them:
#   1. it is the only service that publishes a port; every backend stays on
#      the internal network;
#   2. TLS on all three hostnames, with renewal that nobody has to remember;
#   3. the broker is unreachable without a valid X-API-Key, and a rejected
#      request gets 401 with an NGSI-LD ProblemDetails body, not an HTML page
#      a consumer will try to parse as JSON;
#   4. HSTS and the hardening headers below, on every hostname.
{
	# `email` must never receive an empty argument: that is a Caddyfile parse
	# error, and Caddy then restart-loops with "wrong argument count or
	# unexpected line ending after 'email'" while every service behind it
	# simply looks unreachable.
	#
	# The Caddyfile's own default syntax ({$VAR:fallback}) does not save this,
	# because it applies to an *unset* variable and compose passes ACME_EMAIL
	# as an empty string. docker-compose.yml therefore defaults it to an
	# unusable address, which is never used for localhost (certificates come
	# from Caddy's internal CA) and which Let's Encrypt rejects outright for a
	# real PUBLIC_HOST - a visible failure at issuance rather than a junk
	# contact registered quietly. Set ACME_EMAIL for a real domain.
	email {$ACME_EMAIL}
}

(hardening) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}
	encode gzip
}

{$PUBLIC_HOST} {
	import hardening
	reverse_proxy airflow-apiserver:8080
}

orion.{$PUBLIC_HOST} {
	import hardening
	@authorized header X-API-Key {$ORION_API_KEY}
	handle @authorized {
		reverse_proxy orion-ld:1026
	}
	handle {
		respond `{"type":"https://uri.etsi.org/ngsi-ld/errors/Unauthorized","title":"X-API-Key header required"}` 401
	}
}

influx.{$PUBLIC_HOST} {
	import hardening
	reverse_proxy influxdb:8086
}
