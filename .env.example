# Do not fill this by hand: run ./scripts/gen-secrets.sh, which writes .env
# with random values for every secret below. Listed here so you know what exists.

PUBLIC_HOST=localhost          # your.domain on a server; drives TLS and the three hostnames
ACME_EMAIL=                    # for Let's Encrypt, when PUBLIC_HOST is a real domain

AIRFLOW_UID=50000              # Linux: id -u
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=

POSTGRES_PASSWORD=

MONGO_USER=orion
MONGO_PASSWORD=

ORION_API_KEY=                 # X-API-Key for https://orion.<PUBLIC_HOST>

INFLUX_ORG=datagates
INFLUX_DEFAULT_BUCKET=telemetry
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=
INFLUX_TOKEN=

# Gate secrets referenced as ${VAR} from config/gates.yaml. Only the ones your
# enabled gates use need a value; an unset variable expands to an empty string.
# gen-secrets.sh does not touch these: they belong to somebody else's system.

# field protocols
SNMP_COMMUNITY=                # snmp v1/v2c community (public is a default, not a secret)
OPCUA_USER=
OPCUA_PASSWORD=

# building management and monitoring
OBIX_USER=                     # Niagara / oBIX station user with HTTP Basic enabled
OBIX_PASSWORD=
ZABBIX_TOKEN=                  # Zabbix API token (5.4+); or ZABBIX_USER/PASSWORD
TB_USERNAME=                   # ThingsBoard
TB_PASSWORD=

# web services and portals
MESH_API_KEY=                  # example http_json bearer token
WS_USER=                       # SOAP / http_xml
WS_PASSWORD=
PORTAL_USER=                   # http_csv export endpoint
PORTAL_PASSWORD=

# files
DH_USER=                       # remote_drop over SFTP
DH_PASSWORD=

# messaging
MQTT_USER=
MQTT_PASSWORD=

# other stores
DB_USER=                       # sql gate DSN
DB_PASSWORD=
LEGACY_INFLUX_USER=
LEGACY_INFLUX_PASSWORD=
LEGACY_INFLUX_TOKEN=
CITY_BROKER_KEY=               # ngsi_ld mirror

# markets
ENTSOE_TOKEN=                  # free, from the ENTSO-E Transparency Platform
